# RestoVoice AI Backend Environment Configuration
# Copy this file to .env and fill in your actual values
# NEVER commit the actual .env file to version control

# Database Configuration
DATABASE_URL=postgresql://user:password@localhost:5432/restovoice

# Vapi AI Configuration
VAPI_API_KEY=
VAPI_PHONE_NUMBER_ID=your_vapi_phone_number_id_here

# Google Gemini AI Configuration (for LLM)
GEMINI_API_KEY=your-gemini-api-key-here

# Eleven Labs Voice Configuration (for Vapi voice)
ELEVENLABS_API_KEY="your api key"
ELEVENLABS_VOICE_ID=rachel  # Popular voices: rachel, domi, bella, antoni, elliot, josh
ELEVENLABS_MODEL_ID=eleven_multilingual_v2  # Options: eleven_multilingual_v2, eleven_monolingual_v1
ELEVENLABS_STABILITY=0.5  # 0.0 to 1.0
ELEVENLABS_SIMILARITY_BOOST=0.5  # 0.0 to 1.0
ELEVENLABS_STYLE=0.0  # 0.0 to 1.0
ELEVENLABS_USE_SPEAKER_BOOST=true

# Application Configuration
DEBUG=false
LOG_LEVEL=INFO

# CORS Configuration
ALLOWED_ORIGINS=http://localhost:3000,https://restovoice.com

# Security
SECRET_KEY=your_secret_key_here

# Example values (replace with your actual configuration):
# DATABASE_URL=postgresql://postgres:password@localhost:5432/restovoice
# VAPI_API_KEY=vapi_xxxxxxxxxxxxxxxx
# VAPI_PHONE_NUMBER_id=phone_xxxxxxxxxxxxxxxx
# ELEVENLABS_API_KEY=sk_xxxxxxxxxxxxxxxx
# GEMINI_API_KEY="YOUR_GEMINI_API_KEY_HERE"
